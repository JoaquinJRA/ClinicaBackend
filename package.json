{
  "name": "clinicabackend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
  "dev": "node --watch --env-file=.env ./src/server.js",
  "start": "node ./src/server.js",
  "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
  "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --testPathIgnorePatterns=integration",
  "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --coverage --testPathIgnorePatterns=integration",
  "test:integration": "node --experimental-vm-modules --env-file=.env.test ./node_modules/jest/bin/jest.js --testPathPatterns=integration"
},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoaquinJRA/ClinicaBackend.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JoaquinJRA/ClinicaBackend/issues"
  },
  "homepage": "https://github.com/JoaquinJRA/ClinicaBackend#readme",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.10",
    "twilio": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "jest": "^30.5.1",
    "jest-mock-extended": "^4.0.1",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/services/**/*.js"
    ]
  }
}
