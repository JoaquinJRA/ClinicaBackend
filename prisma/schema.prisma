// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
}

// ─── Modelos ─────────────────────────────────────────────

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id         Int           @id @default(autoincrement())
  nombre     String        @db.VarChar(100)
  apellido   String        @db.VarChar(100)
  email      String        @unique @db.VarChar(150)
  contrasena String        @db.VarChar(255)
  estado     EstadoUsuario @default(ACTIVO)

  emailVerificado      Boolean   @default(true)
  tokenVerificacion    String?   @unique @db.VarChar(255)
  tokenVerificacionExp DateTime?

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  paciente Paciente?
  medico   Medico?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("usuarios")
}

model Paciente {
  id                         Int       @id @default(autoincrement())
  dni                        String    @unique @db.VarChar(15)
  telefono                   String?   @db.VarChar(20)
  telefonoVerificado         Boolean   @default(false)
  direccion                  String?   @db.VarChar(255)
  fechaNacimiento            DateTime?
  genero                     Genero
  tipoSangre                 String?   @db.VarChar(5)
  grupoSanguineo             String?   @map("grupo_sanguineo")
  peso                       Float?
  altura                     Float?
  presionArterial            String?   @map("presion_arterial")
  antecedentesMedicos        String?   @db.Text
  contactoEmergenciaNombre   String?   @db.VarChar(100)
  contactoEmergenciaTelefono String?   @db.VarChar(20)

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  citas           Cita[]
  historialMedico HistorialMedico?
  alergias        alergias[]
  medicamentos    medicamentos[]
  seguimientoMedicamentos SeguimientoMedicamento[]

  @@map("pacientes")
}

model Medico {
  id                Int           @id @default(autoincrement())
  numeroColegiatura String        @unique @db.VarChar(50)
  telefono          String?       @db.VarChar(20)
  estado            EstadoUsuario @default(ACTIVO)

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  especialidadId Int
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  citas     Cita[]
  consultas Consulta[]

  @@map("medicos")
}

model Especialidad {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  medicos Medico[]

  @@map("especialidades")
}

model Cita {
  id     Int        @id @default(autoincrement())
  fecha  DateTime
  estado EstadoCita @default(PENDIENTE)
  motivo String?    @db.VarChar(255)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  medicoId Int
  medico   Medico @relation(fields: [medicoId], references: [id])

  consulta Consulta?
  pago     Pago?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([medicoId, fecha])
  @@map("citas")
}

model alergias {
  id         Int      @id @default(autoincrement())
  nombre     String   @db.VarChar(100)
  severidad  String   @db.VarChar(20)
  pacienteId Int
  creadoEn   DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
}

model SeguimientoMedicamento {
  id            Int      @id @default(autoincrement())
  medicamentoId Int
  pacienteId    Int
  fecha         DateTime
  estado        String   @db.VarChar(20)
  creadoEn      DateTime @default(now())

  medicamento medicamentos @relation(fields: [medicamentoId], references: [id])
  paciente     Paciente     @relation(fields: [pacienteId], references: [id])

  @@unique([medicamentoId, pacienteId, fecha])
  @@map("seguimiento_medicamentos")
}

model medicamentos {
  id            Int      @id @default(autoincrement())
  nombre        String   @db.VarChar(100)
  dosis         String   @db.VarChar(50)
  instrucciones String   @db.VarChar(255)
  frecuencia    String?  @db.VarChar(100)
  fechaInicio   DateTime?
  duracion      Int?
  unidadDuracion String? @db.VarChar(20)
  diasRestantes Int?
  activo        Boolean  @default(true)
  pacienteId    Int
  creadoEn      DateTime @default(now())

  paciente Paciente @relation(fields: [pacienteId], references: [id])
  seguimientos SeguimientoMedicamento[]
}

model HistorialMedico {
  id             Int      @id @default(autoincrement())
  notasGenerales String?  @db.Text
  creadoEn       DateTime @default(now())

  pacienteId Int      @unique
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  consultas Consulta[]

  @@map("historial_medico")
}

model Consulta {
  id          Int      @id @default(autoincrement())
  motivo      String?  @db.VarChar(255)
  sintomas    String?  @db.Text
  diagnostico String   @db.Text
  tratamiento String?  @db.Text
  notas       String?  @db.Text
  creadoEn    DateTime @default(now())

  citaId Int? @unique
  cita   Cita? @relation(fields: [citaId], references: [id])

  historialMedicoId Int
  historialMedico   HistorialMedico @relation(fields: [historialMedicoId], references: [id])

  medicoId Int?
  medico   Medico? @relation(fields: [medicoId], references: [id])

  recetas Receta[]

  @@map("consultas")
}

model Receta {
  id          Int      @id @default(autoincrement())
  descripcion String   @db.Text
  creadoEn    DateTime @default(now())

  consultaId Int
  consulta   Consulta @relation(fields: [consultaId], references: [id])

  @@map("recetas")
}

model Pago {
  id         Int        @id @default(autoincrement())
  monto      Decimal    @db.Decimal(10, 2)
  metodoPago MetodoPago
  estado     EstadoPago @default(PENDIENTE)
  creadoEn   DateTime   @default(now())

  citaId Int  @unique
  cita   Cita @relation(fields: [citaId], references: [id])

  @@map("pagos")
}
