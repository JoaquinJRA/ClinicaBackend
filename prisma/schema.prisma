// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADA
  CANCELADA
  COMPLETADA
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  YAPE
  PLIN
}

enum EstadoPago {
  PENDIENTE
  PAGADO
  FALLIDO
}

// ─── Modelos ─────────────────────────────────────────────

model Rol {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(50)
  descripcion String? @db.VarChar(255)

  usuarios Usuario[]

  @@map("roles")
}

model Usuario {
  id        Int           @id @default(autoincrement())
  nombre    String        @db.VarChar(100)
  apellido  String        @db.VarChar(100)
  email     String        @unique @db.VarChar(150)
  contrasena String       @db.VarChar(255)
  estado    EstadoUsuario @default(ACTIVO)

  emailVerificado      Boolean   @default(false)
  tokenVerificacion    String?   @unique @db.VarChar(255)
  tokenVerificacionExp DateTime?

  rolId Int
  rol   Rol @relation(fields: [rolId], references: [id])

  paciente Paciente?
  medico   Medico?

  creadoEn       DateTime @default(now())
  actualizadoEn  DateTime @updatedAt

  @@map("usuarios")
}

model Paciente {
  id           Int       @id @default(autoincrement())
  dni          String    @unique @db.VarChar(15)
  telefono     String?   @db.VarChar(20)
  direccion    String?   @db.VarChar(255)
  fechaNacimiento DateTime?
  genero       Genero

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  citas           Cita[]
  historialMedico HistorialMedico?

  @@map("pacientes")
}

model Medico {
  id             Int           @id @default(autoincrement())
  numeroColegiatura String     @unique @db.VarChar(50)
  telefono       String?       @db.VarChar(20)
  estado         EstadoUsuario @default(ACTIVO)

  usuarioId Int     @unique
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  especialidadId Int
  especialidad   Especialidad @relation(fields: [especialidadId], references: [id])

  citas Cita[]

  @@map("medicos")
}

model Especialidad {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique @db.VarChar(100)
  descripcion String? @db.VarChar(255)

  medicos Medico[]

  @@map("especialidades")
}

model Cita {
  id     Int        @id @default(autoincrement())
  fecha  DateTime
  estado EstadoCita @default(PENDIENTE)
  motivo String?    @db.VarChar(255)

  pacienteId Int
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  medicoId Int
  medico   Medico @relation(fields: [medicoId], references: [id])

  consulta Consulta?
  pago     Pago?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("citas")
}

model HistorialMedico {
  id            Int      @id @default(autoincrement())
  notasGenerales String? @db.Text
  creadoEn      DateTime @default(now())

  pacienteId Int     @unique
  paciente   Paciente @relation(fields: [pacienteId], references: [id])

  consultas Consulta[]

  @@map("historial_medico")
}

model Consulta {
  id          Int      @id @default(autoincrement())
  diagnostico String   @db.Text
  tratamiento String?  @db.Text
  notas       String?  @db.Text
  creadoEn    DateTime @default(now())

  citaId Int  @unique
  cita   Cita @relation(fields: [citaId], references: [id])

  historialMedicoId Int
  historialMedico   HistorialMedico @relation(fields: [historialMedicoId], references: [id])

  recetas Receta[]

  @@map("consultas")
}

model Receta {
  id          Int      @id @default(autoincrement())
  descripcion String   @db.Text
  creadoEn    DateTime @default(now())

  consultaId Int
  consulta   Consulta @relation(fields: [consultaId], references: [id])

  @@map("recetas")
}

model Pago {
  id           Int        @id @default(autoincrement())
  monto        Decimal    @db.Decimal(10, 2)
  metodoPago   MetodoPago
  estado       EstadoPago @default(PENDIENTE)
  creadoEn     DateTime   @default(now())

  citaId Int  @unique
  cita   Cita @relation(fields: [citaId], references: [id])

  @@map("pagos")
}